rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    match /widgets/{widgetId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;

      // First-time setup only: lets a signed-in user create only their own admin document.
      // Replace this with firestore.rules after the first admin is created.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == true;

      allow update, delete: if isAdmin();
    }
  }
}
